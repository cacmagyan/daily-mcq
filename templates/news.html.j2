<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>News slide {{ slide }}</title>
<style>
@font-face { font-family: 'Poppins'; font-weight: 600; src: url('{{ fonts }}/Poppins-SemiBold.ttf'); }
@font-face { font-family: 'Poppins'; font-weight: 700; src: url('{{ fonts }}/Poppins-Bold.ttf'); }
@font-face { font-family: 'Poppins'; font-weight: 800; src: url('{{ fonts }}/Poppins-ExtraBold.ttf'); }
@font-face { font-family: 'Inter'; font-weight: 400; src: url('{{ fonts }}/Inter-Regular.otf'); }
@font-face { font-family: 'Inter'; font-weight: 500; src: url('{{ fonts }}/Inter-Medium.otf'); }
@font-face { font-family: 'Inter'; font-weight: 600; src: url('{{ fonts }}/Inter-SemiBold.otf'); }
@font-face { font-family: 'Inter'; font-weight: 700; src: url('{{ fonts }}/Inter-Bold.otf'); }
@font-face { font-family: 'Lora'; font-style: italic; font-weight: 400 700; src: url('{{ fonts }}/Lora-Italic-Variable.ttf'); }
@font-face { font-family: 'Caveat'; font-weight: 400 700; src: url('{{ fonts }}/Caveat.ttf'); }
:root { --ink: #1F2A44; --soft: #4A5570; --red: #C8372F; --paper: #FBF7EE; --rule: #D9CFBA; --tag: {{ tag_color }}; }
* { box-sizing: border-box; }
html, body { margin: 0; width: 1080px; height: 1350px; overflow: hidden; background: var(--paper); }
body { font-family: 'Inter', sans-serif; color: var(--ink); }
.page { width: 1080px; height: 1350px; display: flex; flex-direction: column; padding: 0 0 40px; position: relative; }
.mast { background: var(--ink); color: #FBF7EE; padding: 30px 64px 26px; display: flex; align-items: flex-end; justify-content: space-between; }
.mast .name { font-family: 'Lora', serif; font-style: italic; font-weight: 700; font-size: 58px; line-height: 1; letter-spacing: -0.5px; }
.mast .name b { color: #FFD75E; font-weight: 700; }
.mast .date { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 24px; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.9; padding-bottom: 6px; }
.rules { height: 10px; margin: 0 64px; border-bottom: 3px solid var(--ink); }
.rules2 { height: 6px; margin: 0 64px; border-bottom: 1.5px solid var(--ink); }
.body { flex: 1 1 0; min-height: 0; overflow: hidden; padding: 30px 64px 0; display: flex; flex-direction: column; }
.inner { display: flex; flex-direction: column; gap: 26px; }
.kick { font-family: 'Caveat', cursive; font-weight: 700; font-size: 40px; color: var(--red); line-height: 1; }
.big { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 76px; line-height: 1.02; letter-spacing: -1px; }
.big span { background: #FFE36E; padding: 0 12px; border-radius: 8px 16px 10px 18px; }
.row { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 2px solid var(--rule); }
.row:first-child { border-top: 0; }
.numb { flex-shrink: 0; width: 64px; height: 64px; border-radius: 50%; background: var(--ink); color: #FBF7EE; display: flex; align-items: center; justify-content: center;
  font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 32px; }
.chip { display: inline-block; align-self: flex-start; font-family: 'Inter', sans-serif; font-weight: 700; font-size: 22px; letter-spacing: 1.5px; text-transform: uppercase;
  color: #fff; background: var(--c, var(--tag)); padding: 7px 16px 6px; border-radius: 6px; }
.rhead { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 40px; line-height: 1.16; margin-top: 10px; }
.src { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 23px; color: var(--soft); margin-top: 8px; }
.headline { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 62px; line-height: 1.08; letter-spacing: -0.5px; }
.source { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 25px; color: var(--soft); }
.source b { color: var(--ink); font-weight: 700; }
.lab { font-family: 'Caveat', cursive; font-weight: 700; font-size: 40px; color: var(--red); line-height: 1; }
.points { display: flex; flex-direction: column; gap: 18px; }
.pt { display: flex; gap: 18px; align-items: flex-start; font-size: 33px; line-height: 1.32; font-weight: 500; }
.dot { flex-shrink: 0; width: 16px; height: 16px; margin-top: 15px; background: var(--tag); border-radius: 3px; transform: rotate(45deg); }
.why { background: #FFF4C2; border: 3px solid var(--ink); box-shadow: 7px 7px 0 var(--ink); border-radius: 16px 24px 18px 26px / 24px 16px 26px 18px; padding: 18px 26px 22px; }
.why .t { font-size: 31px; line-height: 1.32; font-weight: 500; margin-top: 6px; }
.sticker { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 24px; background: #FFFFFF; color: var(--ink); border: 3px solid #FBF7EE;
  border-radius: 999px; padding: 6px 18px; }
.foot { display: flex; justify-content: space-between; align-items: center; padding: 0 64px; margin-top: 18px; }
.swipe { font-family: 'Caveat', cursive; font-weight: 700; font-size: 38px; color: var(--red); display: flex; align-items: center; gap: 10px; }
.brand { display: flex; align-items: center; gap: 16px; }
.brand .h { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 26px; }
.brand img { width: 74px; height: 74px; object-fit: contain; border-radius: 12px; background: #fff; border: 2.5px solid var(--ink); padding: 3px; }
.end { align-items: center; text-align: center; justify-content: center; height: 100%; gap: 34px; }
.end .big { font-size: 84px; }
.end .line { font-size: 34px; line-height: 1.4; font-weight: 500; max-width: 820px; }
.end .pill { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 40px; background: var(--ink); color: #FFD75E; padding: 16px 34px; border-radius: 999px; }
.end img { width: 190px; height: 190px; object-fit: contain; border-radius: 24px; background: #fff; border: 4px solid var(--ink); padding: 6px; box-shadow: 8px 8px 0 var(--ink); }
.small { font-size: 22px; color: var(--soft); line-height: 1.35; }
</style>
</head>
<body>
<div class="page">
  <div class="mast">
    <div class="name">The CA<b>·</b>CMA Daily</div>
    {% if kind == "story" %}<div class="sticker">{{ index }} / {{ total }}</div>{% else %}<div class="date">{{ date_text }}</div>{% endif %}
  </div>
  <div class="rules"></div><div class="rules2"></div>

  <div class="body" id="content"><div class="inner{% if kind == 'end' %} end{% endif %}" id="inner">
  {% if kind == "cover" %}
    <div class="kick">tonight's news for CA &amp; CMA students</div>
    <div class="big">Today's <span>Top {{ stories|length }}</span></div>
    <div>
    {% for s in stories %}
      <div class="row">
        <div class="numb">{{ loop.index }}</div>
        <div style="display: flex; flex-direction: column; min-width: 0">
          <span class="chip" style="--c: {{ colors[s.tag] }}">{{ s.tag }}</span>
          <div class="rhead">{{ s.headline }}</div>
          <div class="src">{{ s.source }}</div>
        </div>
      </div>
    {% endfor %}
    </div>
  {% elif kind == "story" %}
    <span class="chip">{{ s.tag }}</span>
    <div class="headline">{{ s.headline }}</div>
    <div class="source">Source: <b>{{ s.source }}</b>{% if s.when %} · {{ s.when }}{% endif %}</div>
    <div class="lab">What happened</div>
    <div class="points">
      {% for p in s.points %}<div class="pt"><div class="dot"></div><div>{{ p }}</div></div>{% endfor %}
    </div>
    <div class="why"><div class="lab">Why it matters for you</div><div class="t">{{ s.why_it_matters }}</div></div>
  {% else %}
    {% if logo %}<img src="{{ logo }}" alt="">{% endif %}
    <div class="big">That's the news<br>for today</div>
    <div class="line">Daily MCQs · Concept notes · Cartoon explainers · News, all for CA &amp; CMA students</div>
    <div class="pill">Follow {{ brand.handle or brand.name }}</div>
    <div class="small">Summaries for students from {{ sources }}. Read the full reports at the source.</div>
  {% endif %}
  </div></div>

  <div class="foot">
    {% if kind != "end" %}<div class="swipe">{% if kind == "cover" %}Swipe for the stories{% else %}Swipe{% endif %}
      <svg width="54" height="22" viewBox="0 0 60 24"><path d="M4 12 C 20 6, 36 16, 54 12" fill="none" stroke="#C8372F" stroke-width="4" stroke-linecap="round"/><path d="M44 4 L55 12 L44 20" fill="none" stroke="#C8372F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>{% else %}<div class="swipe">Save &amp; share with your study group</div>{% endif %}
    <div class="brand"><div class="h">{{ brand.handle or brand.name }}</div>{% if logo and kind != "end" %}<img src="{{ logo }}" alt="">{% endif %}</div>
  </div>
</div>
<script>
// Shrinks the content (down to 80%) if it doesn't fit, or opens up the gaps if there is room.
window.fitNews = async function () {
  await document.fonts.ready;
  const box = document.getElementById('content'), inner = document.getElementById('inner');
  const need = () => inner.getBoundingClientRect().height;
  const room = box.clientHeight;
  let zoom = 1; inner.style.zoom = 1;
  if (need() <= room + 1) {
    let gap = 26;
    while (gap < 60) { inner.style.gap = (gap + 4) + 'px'; if (need() > room + 1) { inner.style.gap = gap + 'px'; break; } gap += 4; }
  }
  while (need() > room + 1 && zoom > 0.8) { zoom = Math.round((zoom - 0.02) * 100) / 100; inner.style.zoom = zoom; }
  const loaded = [...document.fonts].filter(f => f.status === 'loaded').map(f => f.family);
  return { zoom: zoom, overflow: need() > room + 1, fonts: loaded };
};
</script>
</body>
</html>
