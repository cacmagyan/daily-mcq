   {
    "say": "The right answer is 3. Here's why.",
    "card": {
     "kind": "answer",
     "small": "The right answer",
     "big": "3"
    }
   },
   {
    "say": "Step one. The arc method divides each change by the average, not by the starting value.",
    "card": {
     "kind": "step",
     "title": "Step 1 · Arc uses averages",
     "rows": [
      "Avg quantity = (150 + 200) ÷ 2 = **175**",
      "Avg price = (100 + 110) ÷ 2 = **105**"
     ]
    },
    "scene": {
     "type": "bars",
     "max": 220,
     "bars": [
      {
       "label": "Before",
       "segments": [
        {
         "v": 150.0,
         "label": "150"
        }
       ]
      },
      {
       "label": "Average",
       "segments": [
        {
         "v": 175.0,
         "label": "175"
        }
       ],
       "top": "use this"
      },
      {
       "label": "After",
       "segments": [
        {
         "v": 200.0,
         "label": "200"
        }
       ]
      }
     ],
     "note": "divide by the middle"
    }
   },
   {
    "say": "Step two. Change in quantity, 50 over 175. Change in price, 10 over 105.",
    "card": {
     "kind": "step",
     "title": "Step 2 · Divide the changes",
     "rows": [
      "50 ÷ 175 = 0.2857",
      "10 ÷ 105 = 0.0952"
     ]
    }
   },
   {
    "say": "Step three. 0.2857 divided by 0.0952 gives exactly 3.",
    "card": {
     "kind": "step",
     "title": "Step 3 · The answer",
     "rows": [
      "0.2857 ÷ 0.0952 = **3**"
     ]
    },
    "scene": {
     "type": "board",
     "lines": [
      "(50 ÷ 175) ÷ (10 ÷ 105)",
      "= 3"
     ]
    }
   },
   {
    "say": "The shortcut. Arc elasticity is change in Q over sum of Qs, divided by change in P over sum of Ps. The twos cancel.",
    "card": {
     "kind": "shortcut",
     "rows": [
      "(ΔQ ÷ ΣQ) ÷ (ΔP ÷ ΣP)",
      "(50 ÷ 350) ÷ (10 ÷ 210) = 3"
     ]
    }
