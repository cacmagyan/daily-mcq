   {
    "say": "Price goes up from ₹100 to ₹110. Supply goes up from 150 units to 200 units. Find the elasticity of supply by the arc method.",
    "card": {
     "kind": "hook",
     "small": "Elasticity of supply",
     "big": "₹100 → ₹110"
    }
   },
   {
    "say": "Quantity is up 50 on 150, that's 33.3 percent. Price is up 10 percent. So 3.33. Right?",
    "card": {
     "kind": "hook",
     "small": "So...",
     "big": "33.3% ÷ 10% = 3.33?"
    }
   },
   {
    "say": "Wrong. 3.33 is the trap.",
    "card": {
     "kind": "trap",
     "small": "CA FOUNDATION MAY 2025 · ECO",
     "big": "3.33 ×",
